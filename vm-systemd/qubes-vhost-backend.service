[Unit]
Description=Qubes vhost-user-net backend daemon
Documentation=https://www.qubes-os.org/
ConditionPathExists=/var/run/qubes-service/vhost-backend
After=qubes-network.service qubes-sysinit.service
Wants=qubes-network.service
PartOf=qubes-network.service

[Service]
Type=notify
ExecStart=/usr/lib/qubes/qubes-vhost-backend
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/run/qubes/vhost
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
