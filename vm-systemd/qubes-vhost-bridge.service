[Unit]
Description=Qubes vhost-user firewall bridge daemon
Documentation=https://www.qubes-os.org/
ConditionPathExists=/var/run/qubes-service/vhost-bridge
After=qubes-firewall.service qubes-sysinit.service
Wants=qubes-firewall.service
PartOf=qubes-firewall.service

[Service]
Type=notify
ExecStartPre=/bin/sh -c 'UPSTREAM=$(/usr/bin/qubesdb-read /qubes-vhost-upstream-socket 2>/dev/null || echo /var/run/qubes/vhost/upstream.sock); echo "UPSTREAM=$UPSTREAM" > /run/qubes-vhost-bridge.env'
EnvironmentFile=-/run/qubes-vhost-bridge.env
ExecStart=/usr/lib/qubes/qubes-vhost-bridge --upstream ${UPSTREAM}
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/run/qubes/vhost
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
